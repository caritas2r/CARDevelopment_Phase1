{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "VehicleSelectionV1",
  "type": "object",
  "required": [
    "query_text",
    "vehicle_type",
    "capacity_practicality",
    "intended_use",
    "powertrain_drivability",
    "features_amenities",
    "ownership_constraints",
    "preference_signals"
  ],
  "properties": {
    "query_text": { "type": "string" },

    "vehicle_type": {
      "type": "object",
      "properties": {
        "include_body_styles": {
          "type": "array",
          "items": { "$ref": "#/definitions/body_style" }
        },
        "exclude_body_styles": {
          "type": "array",
          "items": { "$ref": "#/definitions/body_style" }
        }
      },
      "additionalProperties": false
    },

    "capacity_practicality": {
      "type": "object",
      "properties": {
        "min_seating_capacity": { "type": ["integer", "null"], "minimum": 1 },
        "kid_count": { "type": ["integer", "null"], "minimum": 0 },
        "pet_count": { "type": ["integer", "null"], "minimum": 0 },
        "cargo_priority": { "$ref": "#/definitions/priority_level" },
        "cargo_flexibility": {
          "type": "object",
          "properties": {
            "wants_hatch_access": { "type": "boolean" },
            "wants_fold_flat_seats": { "type": "boolean" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },

    "intended_use": {
      "type": "object",
      "properties": {
        "use_case_tags": {
          "type": "array",
          "items": { "$ref": "#/definitions/use_case_tag" }
        }
      },
      "additionalProperties": false
    },

    "powertrain_drivability": {
      "type": "object",
      "properties": {
        "transmission": { "$ref": "#/definitions/transmission" },
        "drivetrain": { "$ref": "#/definitions/drivetrain" },
        "powertrain_type": { "$ref": "#/definitions/powertrain_type" },
        "fuel_economy_priority": { "$ref": "#/definitions/priority_level" }
      },
      "additionalProperties": false
    },

    "features_amenities": {
      "type": "object",
      "properties": {
        "must_have": {
          "type": "array",
          "items": { "$ref": "#/definitions/feature_tag" }
        },
        "nice_to_have": {
          "type": "array",
          "items": { "$ref": "#/definitions/feature_tag" }
        },
        "avoid": {
          "type": "array",
          "items": { "$ref": "#/definitions/feature_tag" }
        }
      },
      "additionalProperties": false
    },

    "ownership_constraints": {
      "type": "object",
      "properties": {
        "budget": {
          "type": "object",
          "properties": {
            "currency": { "type": "string" },
            "min": { "type": ["number", "null"] },
            "max": { "type": ["number", "null"] },
            "strict_max": { "type": "boolean" }
          },
          "additionalProperties": false
        },
        "year": {
          "type": "object",
          "properties": {
            "min": { "type": ["integer", "null"] },
            "max": { "type": ["integer", "null"] }
          },
          "additionalProperties": false
        },
        "mileage": {
          "type": "object",
          "properties": {
            "max": { "type": ["integer", "null"] },
            "qualitative": { "$ref": "#/definitions/mileage_qualitative" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },

    "preference_signals": {
      "type": "object",
      "properties": {
        "reliability_maintenance_priority": {
          "$ref": "#/definitions/maintenance_priority"
        },
        "safety_priority": { "$ref": "#/definitions/safety_priority" }
      },
      "additionalProperties": false
    },

    "location_constraints": {
      "type": ["object", "null"],
      "properties": {
        "city": { "type": ["string", "null"] },
        "state_region": { "type": ["string", "null"] },
        "radius_miles": { "type": ["number", "null"] },
        "max_radius_miles": { "type": ["number", "null"] }
      },
      "additionalProperties": false
    }
  },

  "definitions": {
    "body_style": {
      "type": "string",
      "enum": ["sedan", "coupe", "hatchback", "wagon", "suv", "crossover", "van", "truck"]
    },
    "priority_level": {
      "type": ["string", "null"],
      "enum": ["low", "medium", "high", null]
    },
    "use_case_tag": {
      "type": "string",
      "enum": ["family", "animals", "commute", "cargo", "travel", "work_light"]
    },
    "transmission": {
      "type": "string",
      "enum": ["automatic", "manual", "other", "unspecified"]
    },
    "drivetrain": {
      "type": "string",
      "enum": ["AWD", "4WD", "FWD", "RWD", "unspecified"]
    },
    "powertrain_type": {
      "type": "string",
      "enum": ["gas", "hybrid", "plug_in_hybrid", "electric", "diesel", "unspecified"]
    },
    "feature_tag": {
      "type": "string",
      "enum": [
        "backup_camera",
        "blind_spot_monitoring",
        "adaptive_cruise_control",
        "apple_carplay",
        "android_auto",
        "heated_seats",
        "leather_seats",
        "sunroof",
        "third_row_seating"
      ]
    },
    "mileage_qualitative": {
      "type": ["string", "null"],
      "enum": ["low", "moderate", "high", "low_or_moderate", null]
    },
    "maintenance_priority": {
      "type": "string",
      "enum": ["low_cost", "balanced", "performance_first", "unspecified"]
    },
    "safety_priority": {
      "type": "string",
      "enum": ["baseline", "enhanced", "unspecified"]
    }
  }
}

