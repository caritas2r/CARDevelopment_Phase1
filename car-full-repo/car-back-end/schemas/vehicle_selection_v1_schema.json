{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "VehicleSelectionV1",
  "type": "object",
  "required": [
    "query_text",
    "vehicle_type",
    "capacity_practicality",
    "intended_use",
    "powertrain_drivability",
    "features_amenities",
    "ownership_constraints",
    "preference_signals"
  ],
  "properties": {
    "query_text": { "type": "string" },
    "make": { "type": "string" },
    "model": { "type": "string" },
    "trim": { "type": "string" },

    "vehicle_type": {
      "type": "object",
      "properties": {
        "include_body_styles": {
          "type": "array",
          "items": { "$ref": "#/definitions/body_style" }
        },
        "exclude_body_styles": {
          "type": "array",
          "items": { "$ref": "#/definitions/body_style" }
        }
      },
      "additionalProperties": false
    },

    "capacity_practicality": {
      "type": "object",
      "properties": {
        "min_seating_capacity": {
          "oneOf": [
            { "type": "integer", "minimum": 1 },
            { "type": "string", "enum": ["unspecified"] }
          ]
        },
        "kid_count": {
          "oneOf": [
            { "type": "integer", "minimum": 0 },
            { "type": "string", "enum": ["unspecified"] }
          ]
        },
        "pet_count": {
          "oneOf": [
            { "type": "integer", "minimum": 0 },
            { "type": "string", "enum": ["unspecified"] }
          ]
        },
        "cargo_priority": { "$ref": "#/definitions/priority_level" },
        "cargo_flexibility": {
          "type": "object",
          "properties": {
            "wants_hatch_access": { "$ref": "#/definitions/boolean_with_unspecified" },
            "wants_fold_flat_seats": { "$ref": "#/definitions/boolean_with_unspecified" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },

    "intended_use": {
      "type": "object",
      "properties": {
        "use_case_tags": {
          "type": "array",
          "items": { "$ref": "#/definitions/use_case_tag" }
        }
      },
      "additionalProperties": false
    },

    "powertrain_drivability": {
      "type": "object",
      "properties": {
        "transmission": { "$ref": "#/definitions/transmission" },
        "drivetrain": { "$ref": "#/definitions/drivetrain" },
        "powertrain_type": {
          "type": "array",
          "items": { "$ref": "#/definitions/powertrain_type" }
        },
        "fuel_economy_priority": { "$ref": "#/definitions/priority_level" }
      },
      "additionalProperties": false
    },

    "features_amenities": {
      "type": "object",
      "properties": {
        "must_have": {
          "type": "array",
          "items": { "$ref": "#/definitions/feature_tag" }
        },
        "nice_to_have": {
          "type": "array",
          "items": { "$ref": "#/definitions/feature_tag" }
        },
        "avoid": {
          "type": "array",
          "items": { "$ref": "#/definitions/feature_tag" }
        }
      },
      "additionalProperties": false
    },

    "ownership_constraints": {
      "type": "object",
      "properties": {
        "budget": {
          "type": "object",
          "properties": {
            "currency": { 
              "oneOf": [
                { "type": "integer" },
                { "type": "string", "enum": ["unspecified"] }
              ]
            },
            "min": {
              "oneOf": [
                { "type": "number" },
                { "type": "string", "enum": ["unspecified"] }
              ]
            },
            "max": {
              "oneOf": [
                { "type": "number" },
                { "type": "string", "enum": ["unspecified"] }
              ]
            },
            "strict_max": { "$ref": "#/definitions/boolean_with_unspecified" }
          },
          "additionalProperties": false
        },
        "year": {
          "type": "object",
          "properties": {
            "min": {
              "oneOf": [
                { "type": "integer" },
                { "type": "string", "enum": ["unspecified"] }
              ]
            },
            "max": {
              "oneOf": [
                { "type": "integer" },
                { "type": "string", "enum": ["unspecified"] }
              ]
            }
          },
          "additionalProperties": false
        },
        "mileage": {
          "type": "object",
          "properties": {
            "max": {
              "oneOf": [
                { "type": "integer" },
                { "type": "string", "enum": ["unspecified"] }
              ]
            },
            "qualitative": { "$ref": "#/definitions/mileage_qualitative" }
          },
          "additionalProperties": false
        },
        "number_of_owners": {
          "oneOf": [
            { "type": "integer", "minimum": 0 },
            { "type": "string", "enum": ["unspecified"] }
          ]
        }
      },
      "additionalProperties": false
    },

    "preference_signals": {
      "type": "object",
      "properties": {
        "reliability_maintenance_priority": {
          "$ref": "#/definitions/maintenance_priority"
        },
        "color": { "$ref": "#/definitions/color" }
      },
      "additionalProperties": false
    },

    "location_constraints": {
      "type": ["object", "null"],
      "properties": {
        "city": { "type": "string" },
        "state_region": { "type": "string" },
        "radius_miles": {
          "oneOf": [
            { "type": "number" },
            { "type": "string", "enum": ["unspecified"] }
          ]
        }
      },
      "additionalProperties": false
    }
  },

  "definitions": {
    "body_style": {
      "type": "string",
      "enum": ["sedan", "coupe", "hatchback", "wagon", "suv", "crossover", "van", "truck", "convertible", "minivan", "unspecified"]
    },
    "priority_level": {
      "type": "string",
      "enum": ["low", "medium", "high", "unspecified"]
    },
    "use_case_tag": {
      "type": "string",
      "enum": ["family", "animals", "commute", "cargo", "travel", "work_light", "pleasure", "performance", "rideshare", "towing", "off_road", "luxury", "budget_value", "unspecified"]
    },
    "transmission": {
      "type": "string",
      "enum": ["automatic", "manual", "other", "cvt", "dual_clutch", "unspecified"]
    },
    "drivetrain": {
      "type": "string",
      "enum": ["AWD", "4WD", "FWD", "RWD", "unspecified"]
    },
    "powertrain_type": {
      "type": "string",
      "enum": ["gas", "hybrid", "plug_in_hybrid", "electric", "diesel", "mild_hybrid", "unspecified"]
    },
    "feature_tag": {
      "type": "string",
      "enum": [
        "backup_camera",
        "blind_spot_monitoring",
        "adaptive_cruise_control",
        "apple_carplay",
        "android_auto",
        "heated_seats",
        "leather_seats",
        "sunroof",
        "third_row_seating",
        "lane_keep_assist",
        "lane_departure_warning",
        "front_parking_sensors",
        "rear_parking_sensors",
        "remote_start",
        "heated_steering_wheel",
        "ventilated_seats",
        "wireless_charging",
        "premium_audio",
        "built_in_navigation",
        "roof_rack",
        "tow_package",
        "panoramic_roof",
        "memory_seats",
        "keyless_entry",
        "unspecified"
      ]
    },
    "mileage_qualitative": {
      "type": "string",
      "enum": ["low", "moderate", "high", "low_or_moderate", "very_low", "very_high", "does_not_matter", "unspecified"]
    },
    "maintenance_priority": {
      "type": "string",
      "enum": ["low_cost", "balanced", "performance_first", "luxury_ok", "unspecified"]
    },
    "color": {
      "type": "string",
      "enum": [
        "black",
        "white",
        "silver",
        "gray",
        "grey",
        "red",
        "blue",
        "green",
        "brown",
        "beige",
        "tan",
        "gold",
        "orange",
        "yellow",
        "purple",
        "burgundy",
        "maroon",
        "navy",
        "teal",
        "pink",
        "unspecified"
      ]
    },
    "boolean_with_unspecified": {
      "type": "string",
      "enum": ["true", "false", "unspecified"]
    }
  }
}

